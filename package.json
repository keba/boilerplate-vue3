{
  "author": "keba",
  "dependencies": {
    "@mdi/font": "7.4.47",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "axios": "1.13.2",
    "lodash": "4.17.21",
    "pinia": "3.0.4",
    "vue": "3.5.24",
    "vue-cookies": "1.8.6",
    "vue-router": "4.6.3",
    "vuetify": "3.10.9"
  },
  "description": "website",
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@stylistic/eslint-plugin": "5.5.0",
    "@types/node": "24.10.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.1",
    "eslint-formatter-junit": "9.0.1",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.5.0",
    "jsdom": "27.1.0",
    "luxon": "3.7.2",
    "rollup-plugin-summary": "3.0.1",
    "sass-embedded": "1.93.3",
    "unplugin-vue-components": "30.0.0",
    "vite": "7.2.2",
    "vite-plugin-vuetify": "2.1.2",
    "vue-eslint-parser": "10.2.0"
  },
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11.6.1",
    "pnpm": "please-use-npm",
    "yarn": "please-use-npm"
  },
  "homepage": "https://github.com/keba/boilerplate-vue3",
  "license": "MIT License",
  "name": "boilerplate-vue3",
  "packageManager": "npm@11.6.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/keba/boilerplate-vue3.git"
  },
  "scripts": {
    "build-hotfix": "(npm run eslint)&&(npm run build-remove-old-files)&&(vite build --mode production)",
    "build-production": "(npm run eslint)&&(npm run build-remove-old-files)&&(vite build --mode production)",
    "build-remove-old-files": "(rm -rf dist)&&(sync)&&(sleep 0.5)",
    "build-staging": "(npm run eslint)&&(npm run build-remove-old-files)&&(vite build --mode staging)",
    "build-tests": "(npm run eslint)&&(npm run build-remove-old-files)&&(vite build --mode test)",
    "build-tests-ci": "(npm run build-remove-old-files)&&(vite build --mode test)",
    "check-circleci": "circleci config validate",
    "check-outdated": "npm outdated || true",
    "dev": "vite",
    "dev-debug": "(npm run eslint)&&(node --inspect ./node_modules/.bin/vite)",
    "dev-force": "(rm -rf node_modules/.vite)&&(sync)&&(sleep 0.5)&&(vite --force)",
    "dev-checked": "(npm run eslint)&&(npm run dev)",
    "dev-checked-host": "(npm run eslint)&&(npm run dev-host)",
    "dev-with-dev-tools": "(export LOAD_DEVTOOLS=true;npm run dev-checked)",
    "dev-host": "vite --host",
    "eslint": "(npm run check-outdated)&&(npm run check-circleci)&&(./node_modules/eslint/bin/eslint.js -c eslint.config.mjs src/** tests/**/*.js playwright.config.js *.mjs)",
    "eslint-fix": "(npm run check-outdated)&&(npm run check-circleci)&&(./node_modules/eslint/bin/eslint.js -c eslint.config.mjs --fix src/** tests/**/*.js playwright.config.js *.mjs)",
    "preview": "vite preview",
    "preview-hotfix": "(npm run eslint)&&(npm run build-hotfix)&&(vite preview)",
    "preview-production": "(npm run eslint)&&(npm run build-production)&&(vite preview)",
    "preview-staging": "(npm run eslint)&&(npm run build-staging)&&(vite preview)",
    "preview-tests": "(npm run eslint)&&(npm run build-tests)&&(vite preview)",
    "tests-start": "(npm run eslint)&&(playwright install --with-deps)&&(export CHECK_SCREENSHOTS=TRUE;playwright test)",
    "tests-start-no-screenshots": "(npm run eslint)&&(playwright install --with-deps)&&(export CHECK_SCREENSHOTS=FALSE;playwright test)",
    "tests-start-raw": "(npm run eslint)&&(playwright install --with-deps)&&(export CHECK_SCREENSHOTS=TRUE;playwright test --project=raw)",
    "tests-start-unauthenticated": "(npm run eslint)&&(playwright install --with-deps)&&(export CHECK_SCREENSHOTS=TRUE;playwright test --project=unauthenticated)",
    "tests-start-with-build": "(npm run eslint)&&(npm run build-tests)&&(playwright install --with-deps)&&(export CHECK_SCREENSHOTS=TRUE;playwright test)"
  },
  "type": "module",
  "version": "1.0.0"
}
