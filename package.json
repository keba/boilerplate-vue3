{
  "author": "keba",
  "dependencies": {
    "@mdi/font": "7.4.47",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "axios": "1.13.2",
    "lodash": "4.17.21",
    "pinia": "3.0.4",
    "vue": "3.5.24",
    "vue-cookies": "1.8.6",
    "vue-router": "4.6.3",
    "vuetify": "3.10.9"
  },
  "description": "website",
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@stylistic/eslint-plugin": "5.5.0",
    "@types/node": "24.10.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.1",
    "eslint-formatter-junit": "9.0.1",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.5.0",
    "jsdom": "27.1.0",
    "luxon": "3.7.2",
    "rollup-plugin-summary": "3.0.1",
    "sass-embedded": "1.93.3",
    "unplugin-vue-components": "30.0.0",
    "vite": "7.2.2",
    "vite-plugin-vuetify": "2.1.2",
    "vue-eslint-parser": "10.2.0"
  },
  "engines": {
    "node": ">=24.11.0",
    "npm": "please-use-pnpm",
    "pnpm": ">=10.20.0",
    "yarn": "please-use-pnpm"
  },
  "homepage": "https://github.com/keba/boilerplate-vue3",
  "license": "MIT License",
  "name": "boilerplate-vue3",
  "packageManager": "pnpm@10.20.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/keba/boilerplate-vue3.git"
  },
  "scripts": {
    "build-checked-hotfix": "(pnpm run eslint)&&(pnpm run build-hotfix)",
    "build-checked-production": "(pnpm run eslint)&&(pnpm run build-production)",
    "build-checked-staging": "(pnpm run eslint)&&(pnpm run build-staging)",
    "build-checked-tests": "(pnpm run eslint)&&(pnpm run build-tests)",
    "build-hotfix": "(pnpm run build-remove-old-files)&&(vite build --mode production)",
    "build-production": "(pnpm run build-remove-old-files)&&(vite build --mode production)",
    "build-remove-old-files": "(rm -rf dist)&&(sync)&&(sleep 0.5)",
    "build-staging": "(pnpm run build-remove-old-files)&&(vite build --mode staging)",
    "build-tests": "(pnpm run build-remove-old-files)&&(vite build --mode test)",
    "check-circleci": "circleci config validate",
    "check-outdated": "pnpm outdated || true",
    "dev": "vite",
    "dev-debug": "(pnpm run eslint)&&(node --inspect ./node_modules/.bin/vite)",
    "dev-force": "(rm -rf node_modules/.vite)&&(sync)&&(sleep 0.5)&&(vite --force)",
    "dev-checked": "(pnpm run eslint)&&(pnpm run dev)",
    "dev-checked-host": "(pnpm run eslint)&&(pnpm run dev-host)",
    "dev-with-dev-tools": "(export LOAD_DEVTOOLS=true;pnpm run dev-checked)",
    "dev-host": "vite --host",
    "preview": "vite preview",
    "preview-hotfix": "(pnpm run eslint)&&(pnpm run build-hotfix)&&(vite preview)",
    "preview-production": "(pnpm run eslint)&&(pnpm run build-production)&&(vite preview)",
    "preview-staging": "(pnpm run eslint)&&(pnpm run build-staging)&&(vite preview)",
    "preview-tests": "(pnpm run eslint)&&(pnpm run build-tests)&&(vite preview)",
    "tests-start": "(pnpm run eslint)&&(playwright install --with-deps)&&(export CHECK_SCREENSHOTS=TRUE;playwright test)",
    "tests-start-no-screenshots": "(pnpm run eslint)&&(playwright install --with-deps)&&(export CHECK_SCREENSHOTS=FALSE;playwright test)",
    "tests-start-raw": "(pnpm run eslint)&&(playwright install --with-deps)&&(export CHECK_SCREENSHOTS=TRUE;playwright test --project=raw)",
    "tests-start-unauthenticated": "(pnpm run eslint)&&(playwright install --with-deps)&&(export CHECK_SCREENSHOTS=TRUE;playwright test --project=unauthenticated)",
    "tests-start-with-build": "(pnpm run eslint)&&(pnpm run build-tests)&&(playwright install --with-deps)&&(export CHECK_SCREENSHOTS=TRUE;playwright test)",
    "eslint": "(pnpm run check-outdated)&&(pnpm run check-circleci)&&(./node_modules/eslint/bin/eslint.js -c eslint.config.mjs src/** tests/**/*.js playwright.config.js *.mjs)",
    "eslint-fix": "(pnpm run check-outdated)&&(pnpm run check-circleci)&&(./node_modules/eslint/bin/eslint.js -c eslint.config.mjs --fix src/** tests/**/*.js playwright.config.js *.mjs)"
  },
  "type": "module",
  "version": "1.0.0"
}
